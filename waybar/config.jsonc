{
  "layer": "top",
  "position": "top",
  "modules-left": ["sway/workspaces"],

  "modules-center": ["clock"],

  "modules-right": [
    "sway/language",
    "pulseaudio",
    "backlight",
    "network",
    "cpu",
    "memory",
    "temperature",
    "tray",
    "custom/lock",
  ],

  "tray": {
    "icon-size": 16,
    "spacing": 6 
  },

  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%d/%m - %H:%M}",
    "interval": 1
  },

  "network": {
    "format-wifi": "󰤢 ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰤠 No Network",
    "interval": 5,
    "tooltip": false
  },
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
    "interval": 1,
  },

  "cpu": {
    "interval": 1,
    "format": "  {usage}%",
  },

  "memory": {
    "interval": 30,
    "format": "  {used:0.1f}G"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "pavucontrol"
  },
}

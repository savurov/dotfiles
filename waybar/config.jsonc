[
  {
    // === HDMI-A-2: main monitor (normal full bar) ===
    "output": "HDMI-A-2",
    "layer": "top",
    "position": "top",

    "modules-left": ["sway/workspaces"],
    "modules-center": ["clock"],
    "modules-right": [
      "custom/kbd",
      "pulseaudio",
      "cpu",
      "custom/memory",
      "temperature",
      "custom/brightness",
      "custom/notification",
      "tray",
    ],

    "tray": {
      "icon-size": 18,
      "spacing": 10,
    },

    "clock": {
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format": "{:%d %b  %H:%M}",
      "interval": 1,
    },

    "temperature": {
      "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
      "interval": 1,
    },

    "cpu": {
      "interval": 1,
      "format": "󰍛  {usage}%",
    },

    "custom/memory": {
      "interval": 5,
      "return-type": "json",
      "exec": "~/.config/waybar/scripts/memory-top5.sh",
    },

    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟  mute",
      "format-icons": {
        "default": ["󰕿", "󰖀", "󰕾"],
      },
      "on-click": "pavucontrol",
    },

    "custom/brightness": {
      "return-type": "json",
      "exec": "sh -c \"pct=$(jq -r '((.mode // 5) | tonumber) * 10' ~/.config/sway/brightness/store.json 2>/dev/null) && printf '{\\\"text\\\":\\\"󰃠 %s%%\\\",\\\"tooltip\\\":\\\"Brightness %s%%\\\",\\\"class\\\":\\\"brightness\\\",\\\"percentage\\\":%s}\\n' \\\"\\$pct\\\" \\\"\\$pct\\\" \\\"\\$pct\\\" || printf '%s\\n' '{\\\"text\\\":\\\"󰃠 50%\\\",\\\"tooltip\\\":\\\"Brightness 50%\\\",\\\"class\\\":\\\"brightness\\\",\\\"percentage\\\":50}'\"",
      "interval": 1,
      "tooltip": true,
    },

    "custom/kbd": {
      "interval": 1,
      "exec": "swaymsg -t get_inputs | jq -r '[.[]? | select(.type==\"keyboard\") | .xkb_active_layout_name][0] // \"\" | ascii_downcase | if test(\"russian|рус\") then \"ru\" elif test(\"english|англ\") then \"us\" else .[0:2] end'",
      "format": "{}",
      "tooltip": false,
    },
    "sway/workspaces": {
      "alphabetical_sort": true,
    },
    "custom/notification": {
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "format": " {}",
      "tooltip": true,
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
    },
  },
  {
    // === HDMI-A-1: vertical monitor (no right modules) ===
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",

    "modules-left": ["sway/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/kbd"],

    "clock": {
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format": "{:%d %b  %H:%M}",
      "interval": 1,
    },

    "custom/kbd": {
      "interval": 1,
      "exec": "swaymsg -t get_inputs | jq -r '[.[]? | select(.type==\"keyboard\") | .xkb_active_layout_name][0] // \"\" | ascii_downcase | if test(\"russian|рус\") then \"ru\" elif test(\"english|англ\") then \"us\" else .[0:2] end'",
      "format": "{}",
      "tooltip": false,
    },
    "sway/workspaces": {
      "alphabetical_sort": true,
    },
  },
]

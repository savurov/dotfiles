set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu wofi --show drun -i --matching contains

# restart waybar
exec_always --no-startup-id sh -c 'pkill -x waybar; waybar'

# mouse
seat * hide_cursor 5000
seat * hide_cursor when-typing enable
input type:pointer {
    accel_profile adaptive
    pointer_accel -0.2
}

# screens
output * dpms on

output * bg #1F2430 solid_color
output * adaptive_sync on
output HDMI-A-1 {
    resolution 1920x1080@74.986Hz
    transform 90
    position 1920 0
    scale 1
}

output HDMI-A-2 {
    resolution 1920x1080@100.047Hz
    position 0 0
    scale 1
}


### Keymaps
bindsym --to-code $mod+Return exec $term
bindsym --to-code $mod+q kill
bindsym --to-code $mod+d exec $menu
bindsym --to-code $mod+Shift+c reload
bindsym --to-code $mod+Shift+e exec swaymsg exit

# Move focus
exec_always ~/.config/sway/scripts/onfocus-layout.sh &

bindsym --to-code $mod+$left  focus left;
bindsym --to-code $mod+$down  focus down;
bindsym --to-code $mod+$up    focus up;
bindsym --to-code $mod+$right focus right;

# Resize
bindsym --to-code $mod+Right resize shrink width 40px
bindsym --to-code $mod+Left resize grow width 40px
bindsym --to-code $mod+Up resize grow height 40px
bindsym --to-code $mod+Down resize shrink height 40px

# Move the focused window
bindsym --to-code $mod+Shift+$left move left
bindsym --to-code $mod+Shift+$down move down
bindsym --to-code $mod+Shift+$up move up
bindsym --to-code $mod+Shift+$right move right


### Workspaces
bindsym $mod+a move workspace to output left

bindsym --to-code $mod+c exec ~/.config/sway/scripts/gpt.sh
bindsym --to-code $mod+f exec ~/.config/sway/scripts/chrome.sh
bindsym --to-code $mod+v exec ~/.config/sway/scripts/nvim.sh
bindsym --to-code $mod+b exec ~/.config/sway/scripts/nvim2.sh

# Switch to workspace
bindsym --to-code $mod+z workspace number 1
bindsym --to-code $mod+x workspace number 2
bindsym --to-code $mod+3 workspace number 3
bindsym --to-code $mod+4 workspace number 4
bindsym --to-code $mod+5 workspace number 5

# Move focused container to workspace
bindsym --to-code $mod+Shift+s splith
bindsym --to-code $mod+g splith
bindsym --to-code $mod+s splitv

# add sway/wayland env variables
include /etc/sway/config.d/*.conf

# keyboard
input type:keyboard {
  xkb_layout "us, ru",
  xkb_options "grp:win_space_toggle"
}

# borders and gaps
client.focused          #7aa2f7 #7aa2f7 #ffffff #7aa2f7 #7aa2f7
default_border pixel 1

smart_gaps off
gaps inner 5
gaps outer 1

# internet/bluetooth managers
exec_always --no-startup-id sh -c 'pkill -x nm-applet; nm-applet'
exec_always --no-startup-id sh -c 'pkill -x blueman-applet; blueman-applet'

# copy with notify
exec wl-paste -t text --watch sh -c 't="$(cat)"; [ -z "${t//[[:space:]]/}" ] && exit 0; s="$(printf "%.15s" "$t")"; [ ${#t} -gt 10 ] && s="$s…"; notify-send "Clipboard updated" "$s"; printf "%s\n" "$t" | clipman store --no-persist'

# screenshots
bindsym --to-code $mod+i exec grim -g "$(slurp)" - | wl-copy
# notifications
exec_always --no-startup-id sh -c 'pkill -x swaync; swaync'


# disable sleeping mode
set $lock_timeout 0
set $screen_timeout 0
exec_always pkill -x swayidle
exec_always swaymsg "output * power on"

# brightness 
exec_always --no-startup-id sh -c 'sleep 1; ~/.config/sway/scripts/ddc-brightness init'
bindsym --to-code $mod+p exec ~/.config/sway/scripts/ddc-brightness up
bindsym --to-code $mod+o exec ~/.config/sway/scripts/ddc-brightness down



### FLOATING
bindsym $mod+t floating toggle
for_window [workspace="4"] floating enable

# win+mouse to move/resize
floating_modifier $mod normal

# Большинство мелких служебных окон и диалогов
for_window [window_type="dialog"] floating enable
for_window [window_type="utility"] floating enable
for_window [window_type="toolbar"] floating enable
for_window [window_type="splash"] floating enable
for_window [window_type="menu"] floating enable
for_window [window_type="dropdown_menu"] floating enable
for_window [window_type="popup_menu"] floating enable
for_window [window_type="tooltip"] floating enable
for_window [window_type="notification"] floating enable

for_window [title="^(Library|Settings|Preferences|Bookmarks|Downloads|Extensions).*"] floating enable, move position center

# Часто помогает для попапов/модалок в приложениях
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

for_window [app_id="pavucontrol"] floating enable, move position center
for_window [app_id="nm-connection-editor"] floating enable, move position center
for_window [app_id="blueman-manager"] floating enable, move position center
for_window [app_id="qalculate-gtk"] floating enable, move position center
for_window [class="zoom"] floating enable, move position center
for_window [title="Picture-in-Picture"] floating enable


for_window [app_id="firefox-chat"] move to workspace Chat
for_window [app_id="firefox-default"] move to workspace Firefox

# REAPER: everything floating by default
for_window [class="REAPER"] floating enable, move position center
for_window [class="REAPER" title="^REAPER v.*"] floating disable
